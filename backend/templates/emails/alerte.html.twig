{# Gabarit commun aux alertes et au récap quotidien : styles en ligne pour les clients de messagerie. #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ message.sujet }}</title>
</head>
<body style="margin:0;padding:0;background:#f6f3ec;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:#14213d;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f3ec;">
    <tr><td align="center" style="padding:24px 12px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:14px;overflow:hidden;">
            <tr><td style="background:#14213d;color:#f6f3ec;padding:20px 24px;">
                <div style="font-size:13px;letter-spacing:.08em;text-transform:uppercase;opacity:.75;">Radar Bons Plans</div>
                <div style="font-size:22px;font-weight:700;margin-top:4px;">{{ message.sujet }}</div>
            </td></tr>
            <tr><td style="padding:20px 24px 8px;font-size:15px;line-height:1.5;">
                <p style="margin:0 0 12px;">{{ message.intro }}</p>
                {% if message.resume is not empty %}
                    <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 8px;">
                        {% for phrase in message.resume %}
                            <tr><td style="padding:2px 0;font-weight:600;">• {{ phrase }}</td></tr>
                        {% endfor %}
                    </table>
                {% endif %}
            </td></tr>
            {% for titre, lignes in message.sections %}
                {% if lignes is not empty %}
                    <tr><td style="padding:12px 24px 4px;">
                        <div style="font-size:17px;font-weight:700;border-bottom:2px solid #f6f3ec;padding-bottom:6px;">{{ titre }}</div>
                    </td></tr>
                    {% for ligne in lignes %}
                        <tr><td style="padding:8px 24px;border-bottom:1px solid #efeae0;">
                            <a href="{{ ligne.url }}" style="color:#14213d;text-decoration:none;display:block;">
                                {% if ligne.qui %}<span style="font-size:12px;font-weight:700;text-transform:uppercase;color:#5b6478;">{{ ligne.qui }}</span><br>{% endif %}
                                <span style="font-size:15px;font-weight:600;">{{ ligne.titre }}</span>
                                {% if ligne.valeur or ligne.echeance %}<br>
                                    {% if ligne.valeur %}<span style="color:#1f7a6d;font-weight:700;">{{ ligne.valeur }}</span>{% endif %}
                                    {% if ligne.echeance %}<span style="color:#e63946;font-weight:700;margin-left:8px;">{{ ligne.echeance }}</span>{% endif %}
                                {% endif %}
                            </a>
                        </td></tr>
                    {% endfor %}
                {% endif %}
            {% endfor %}
            {% if message.lienAppli %}
                <tr><td align="center" style="padding:24px;">
                    <a href="{{ message.lienAppli }}" style="display:inline-block;background:#14213d;color:#f6f3ec;padding:12px 24px;border-radius:999px;text-decoration:none;font-weight:700;">Ouvrir Radar</a>
                </td></tr>
            {% endif %}
            <tr><td style="padding:16px 24px;background:#efeae0;font-size:12px;color:#5b6478;">
                Liens vers les sites d'origine (Anti-crise.fr, Shopmium, Envie de Bien Manger, Radins.com…). Vous pouvez modifier vos alertes dans les préférences de l'application.
            </td></tr>
        </table>
    </td></tr>
</table>
</body>
</html>

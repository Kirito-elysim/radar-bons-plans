# ------------------------------------------------------------------
# Radar Bons Plans — variables d'environnement
# Copier en .env.local (backend/) ou dans les variables Coolify.
# Les sections suivantes seront complétées au fil des étapes.
# ------------------------------------------------------------------

# Port exposé sur la machine hôte pour PostgreSQL (55432 par défaut, 5433/5434 étant souvent pris)
POSTGRES_PORT_HOTE=55432

# Connexion à PostgreSQL 16 depuis les conteneurs (développement ; en production, construite par compose.prod.yaml)
DATABASE_URL="postgresql://radar:radar@postgres:5432/radar?serverVersion=16&charset=utf8"

# Symfony : « prod » en production, secret aléatoire (openssl rand -hex 16)
APP_ENV=prod
APP_SECRET=change-moi

# PostgreSQL de production (compose.prod.yaml construit DATABASE_URL à partir de ces valeurs)
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-moi

# Proxys de confiance (Traefik de Coolify, puis nginx) : réseaux privés par défaut
TRUSTED_PROXIES=private_ranges

# ---------------------------------- Collecte ----------------------------------
# User-Agent envoyé aux sites sources : doit identifier le robot et donner un moyen de contact.
# Le premier mot (« RadarBonsPlans ») est le jeton comparé aux groupes du robots.txt.
COLLECTE_USER_AGENT="RadarBonsPlans/1.0 (+mailto:vous@exemple.fr)"

# ------------------------------------ API -------------------------------------
# Clés JWT : générées par « make jwt » dans backend/config/jwt/ (jamais commitées).
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Phrase secrète des clés : à changer en production (openssl rand -hex 32).
JWT_PASSPHRASE=change-moi
# Durée de validité du jeton en secondes (7 jours).
JWT_TTL=604800
# Origines autorisées à appeler l'API depuis un autre domaine. En production la PWA et l'API partagent
# le même domaine : laisser vide (^$).
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
# 1 = création de compte libre via POST /api/inscription ; 0 = comptes créés avec « make utilisateur ».
INSCRIPTIONS_OUVERTES=0

# ---------------------------------- Alertes -----------------------------------
# File des tâches de fond (collecte, alertes, récap) : PostgreSQL via Doctrine
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# E-mail : smtp://utilisateur:motdepasse@smtp.exemple.fr:587 (null://null = désactivé)
MAILER_DSN=null://null
MAILER_FROM="Radar Bons Plans <radar@votre-domaine.fr>"
# Bot Telegram créé avec @BotFather : telegram://123456:ABC-DEF@default (null://null = désactivé)
TELEGRAM_DSN=null://null
# Adresse publique de la PWA (liens des notifications)
APP_URL_FRONT=https://radar.votre-domaine.fr
# Administrateur prévenu si un connecteur renvoie 0 résultat
ADMIN_EMAIL=
ADMIN_TELEGRAM_CHAT_ID=
# Web Push : clés générées par « bin/console app:push:generer-cles » (garder la privée secrète)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@votre-domaine.fr

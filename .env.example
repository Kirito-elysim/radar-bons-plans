# ------------------------------------------------------------------
# Radar Bons Plans — variables d'environnement
# Copier en .env.local (backend/) ou dans les variables Coolify.
# Les sections suivantes seront complétées au fil des étapes.
# ------------------------------------------------------------------

# Port exposé sur la machine hôte pour PostgreSQL (55432 par défaut, 5433/5434 étant souvent pris)
POSTGRES_PORT_HOTE=55432

# Connexion à PostgreSQL 16 depuis les conteneurs
DATABASE_URL="postgresql://radar:radar@postgres:5432/radar?serverVersion=16&charset=utf8"

# Symfony : « prod » en production, secret aléatoire de 32 caractères
APP_ENV=dev
APP_SECRET=change-moi
